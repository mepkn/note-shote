# Development (.env.local) — written for you by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:<generated-name>
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Production (.env.prod.local — git-ignored, read literally by scripts/deploy-*.sh)
# CONVEX_DEPLOY_KEY=prod:<production deploy key>
# EXPO_PUBLIC_CONVEX_URL=https://<prod-deployment>.convex.cloud   (baked into the web export)
# DEPLOY_HOST=<ssh user@host>
# DEPLOY_PORT=<ssh port>
# DEPLOY_DIR=/var/www/note-shote

# EAS (.eas-token — git-ignored, read by scripts/eas.sh)
# export EXPO_TOKEN=<personal Expo access token>

# Convex-side env vars — set on each deployment with `npx convex env set`
# JWT_PRIVATE_KEY=...  } generated by `npx @convex-dev/auth`
# JWKS=...             }
# SITE_URL=noteshote://
# ALLOWED_EMAILS=you@example.com,other@example.com  (required; unset = nobody can sign in)
